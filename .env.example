# Local mode by default. See docs/customer-trial.md for open-registration HTTPS hosting.
DATABASE_URL=postgresql+psycopg://meridian:meridian@127.0.0.1:54329/meridian
WORKSPACE_ID=local-personal
UPLOAD_DIR=./data/uploads
# Each provider is explicit. Live errors NEVER fall back to Mock.
# live: SerpAPI discovery; Apify public profiles; separate Apollo or Apify work-email lookup
PEOPLE_MODE=mock
PUBLIC_SEARCH_MODE=mock
AI_MODE=mock
APOLLO_API_KEY=
SERPAPI_API_KEY=
APIFY_API_KEY=
APIFY_PROFILE_ACTOR=harvestapi/linkedin-profile-scraper
APIFY_MAX_CHARGE_USD=0.05
PEOPLE_CACHE_HOURS=168
# Legacy/default endpoint; existing deployments and saved model IDs remain supported.
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_PROVIDER=bailian
AI_MODELS=qwen-plus,qwen-turbo,qwen-max
# One Bailian key covers multiple model authors. The existing AI_API_KEY above
# is reused for bailian/* when the endpoint matches. This override is optional.
DASHSCOPE_API_KEY=
# Optional default: bailian/deepseek-v4-flash, bailian/kimi-k3, bailian/glm-5.2,
# bailian/MiniMax-M2.5, bailian/qwen3.8-flash.
# Empty keeps AI_MODEL above as the default.
AI_DEFAULT_MODEL=
# Optional JSON provider overrides/custom endpoints. See docs/ai-model-providers.md.
AI_PROVIDERS=[]
AI_TIMEOUT_SECONDS=60
PROVIDER_CALLS_PER_MINUTE=20
BACKEND_URL=http://127.0.0.1:8000
# Set on the frontend service for the public /about and /privacy pages.
PUBLIC_SUPPORT_EMAIL=

AUTH_MODE=local
# For Google sign-in: AUTH_MODE=open (or invite) and AUTH_PROVIDER=google.
# Local mode bypasses login for private development, even with this provider set.
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional separate OAuth client for Gmail. If both are blank, reuse GOOGLE_CLIENT_*.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Generate once with Fernet.generate_key(); keep out of Git and separate from DB.
# For rotation: new key first, comma-separated old keys after it.
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_WORKER_ENABLED=true
GMAIL_SYNC_INTERVAL_SECONDS=120
GMAIL_DAILY_SEND_LIMIT=100
# Add PUBLIC_ORIGIN + /api/mailboxes/callback to this client's redirect URIs.
# See docs/gmail-integration.md for consent, sync filtering and acceptance.
# Google Console redirect URI must equal PUBLIC_ORIGIN + /api/auth/google/callback.
# See docs/google-sign-in.md. Keep client secret on the backend only.
# Legacy password deployments may explicitly retain AUTH_PROVIDER=password.
# Administrator bootstrap accepts only
# a scrypt hash generated with app.routers.auth.password_hash, never a plaintext password.
BOOTSTRAP_ADMIN_PASSWORD_HASH=
PUBLIC_ORIGIN=http://127.0.0.1:3100
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
SESSION_DAYS=7
